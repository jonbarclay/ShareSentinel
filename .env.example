# ============================================================
# ShareSentinel Configuration
# Copy this file to .env and fill in your values
# ============================================================

# --- Redis ---
REDIS_PASSWORD=CHANGE_ME_strong_redis_password

# --- PostgreSQL ---
POSTGRES_DB=sharesentinel
POSTGRES_USER=sharesentinel
POSTGRES_PASSWORD=CHANGE_ME_strong_password_here

# --- Microsoft Graph API (Azure AD App Registration) ---
AZURE_TENANT_ID=your-tenant-id
AZURE_CLIENT_ID=your-client-id
AZURE_CLIENT_SECRET=your-client-secret

# --- AI Provider ---
# Options: anthropic, openai, gemini
AI_PROVIDER=anthropic

# Anthropic
ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# OpenAI
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o

# Google Gemini
GEMINI_API_KEY=your-key-here
GEMINI_MODEL=gemini-2.0-flash
VERTEX_PROJECT=your-gcp-project-id
VERTEX_LOCATION=us-central1

# AI Settings
AI_TEMPERATURE=0

# --- Processing ---
MAX_FILE_SIZE_BYTES=52428800
MAX_AV_FILE_SIZE_BYTES=1610612736
TEXT_CONTENT_LIMIT=100000
HASH_REUSE_DAYS=30
MAX_CONCURRENT_JOBS=5
MAX_CONCURRENT_AV_JOBS=2

# --- Requeue / Retry ---
# Max times a transient-failed event is retried before permanent failure
MAX_EVENT_RETRIES=3
# Base delay in seconds before requeue (doubles per retry: 60, 120, 240)
REQUEUE_BASE_DELAY_SECONDS=60
# Minutes an event can sit in 'processing' before startup recovery requeues it
STUCK_PROCESSING_TIMEOUT_MINUTES=30

# --- Transcription (Audio/Video Pipeline) ---
TRANSCRIPTION_ENABLED=true
# Graph API transcript retrieval timeout (seconds)
GRAPH_TRANSCRIPT_TIMEOUT_SECONDS=30
# Local Whisper transcription via transcriber container
WHISPER_ENABLED=true
WHISPER_MODEL=base.en
WHISPER_SERVICE_URL=http://transcriber:8090
# Device for Whisper inference (cpu or cuda)
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# --- Notifications ---
# Set to false to disable analyst alert emails (AI detection alerts)
# User notifications (post-disposition emails to file owners) are separate
ANALYST_NOTIFICATION_ENABLED=true
# Comma-separated: email,jira
NOTIFICATION_CHANNELS=email
NOTIFY_ON_FOLDER_SHARE=true
NOTIFY_ON_FAILURE=true

# Email (SMTP)
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=sharesentinel@yourorg.com
SMTP_PASSWORD=CHANGE_ME
SMTP_USE_TLS=true
EMAIL_FROM=sharesentinel@yourorg.com
EMAIL_TO=analyst1@yourorg.com,analyst2@yourorg.com

# Jira (Phase 2)
JIRA_URL=https://yourorg.atlassian.net
JIRA_EMAIL=sharesentinel@yourorg.com
JIRA_API_TOKEN=your-jira-api-token
JIRA_PROJECT_KEY=SECOPS
JIRA_ISSUE_TYPE=Task

# --- Security / Remediation ---
SECURITY_EMAIL=security@yourorg.com

# --- User Notifications (post-disposition emails to file owners) ---
# Keep disabled by default to avoid accidental end-user messaging during setup
USER_NOTIFICATION_ENABLED=false
# Override recipient — all user notification emails go to this address instead (dev/testing)
USER_NOTIFICATION_OVERRIDE_EMAIL=
# BCC address(es) — receive a copy of every user notification email.
# Multiple addresses may be provided as a comma-separated list, e.g.:
#   USER_NOTIFICATION_BCC=admin@example.com,ferpa@example.com
USER_NOTIFICATION_BCC=
# Optional: use a different AI provider for email generation (defaults to AI_PROVIDER)
USER_NOTIFICATION_AI_PROVIDER=

# --- Sharing Link Lifecycle ---
LIFECYCLE_CHECK_INTERVAL_HOURS=24
LIFECYCLE_MAX_DAYS=180
# Send countdown + removal-confirmation emails to file owners. Set to false to
# suppress all owner-facing lifecycle emails; links are still removed at
# LIFECYCLE_MAX_DAYS.
LIFECYCLE_NOTIFICATIONS_ENABLED=true

# --- Audit Log Polling ---
AUDIT_POLL_ENABLED=true
AUDIT_POLL_INTERVAL_MINUTES=15
# Also ingest provisioning events (SiteCollectionCreated, "Add group.",
# "Add user.") and enforce sharing/CWS/visibility policy on newly created
# sites, OneDrives, and M365 groups within one poll cycle (~15 min) instead
# of waiting for the next scheduled sweep. OneDrives are covered via their
# SiteCollectionCreated event (fired on the user's first OneDrive access);
# "Add user." itself is logged only, since no OneDrive exists yet at account
# creation. Requires the app registration to hold AuditLogsQuery.Read.All —
# the SharePoint-scoped variant cannot read azureActiveDirectory records
# (the poller falls back to sharing-only filters and logs an error if the
# permission is missing).
AUDIT_POLL_PROVISIONING_ENABLED=true
# Reconciliation pass: unified audit log records routinely surface 30 min to
# several hours after the activity; the incremental poll (5-min overlap) misses
# them permanently. Every RECONCILE_INTERVAL hours the poller re-queries the
# trailing LOOKBACK window and dedup drops the already-seen records. Set either
# to 0 to disable.
AUDIT_POLL_LOOKBACK_HOURS=12
AUDIT_POLL_RECONCILE_INTERVAL_HOURS=6

# --- Second-Look AI Review ---
SECOND_LOOK_ENABLED=false
SECOND_LOOK_PROVIDER=gemini
SECOND_LOOK_MODEL=gemini-3.1-pro-preview

# --- Site Policy Enforcement (dual: visibility + anonymous sharing) ---
# Enable daily enforcement of both site visibility and anonymous sharing policies
# Visibility: sets Public M365 groups to Private unless allow-listed
# Sharing: disables anonymous sharing on sites unless allow-listed
SITE_POLICY_ENABLED=false
# How often to run scheduled enforcement (hours, default 24 = daily)
SITE_POLICY_INTERVAL_HOURS=24
# Sharing capability to set on allow-listed sites (anonymous sharing allowed)
SITE_POLICY_ENABLED_SHARING_CAPABILITY=ExternalUserAndGuestSharing
# Sharing capability to set on non-allow-listed sites (blocks anonymous links)
SITE_POLICY_DISABLED_SHARING_CAPABILITY=ExternalUserSharingOnly
# Run the weekly OneDrive sharing-capability sweep (OneDrives are subject to
# the same anonymous-sharing policy as SharePoint sites but are far more
# numerous, so they sweep on their own cadence; event-driven remediation
# covers the gap between sweeps)
SITE_POLICY_INCLUDE_ONEDRIVE=true
# How often the OneDrive sweep runs (hours, default 168 = weekly)
SITE_POLICY_ONEDRIVE_INTERVAL_HOURS=168
# Fail a scan whose site enumeration returns fewer than this % of the recent
# peak for the same scan type (guards against silent inventory truncation;
# 0 disables)
SITE_POLICY_SCAN_FLOOR_PCT=50
# SharePoint admin site URL (e.g., https://yourtenant-admin.sharepoint.com)
SHAREPOINT_ADMIN_URL=https://yourtenant-admin.sharepoint.com

# --- Event-driven remediation (worker) ---
# When a share-link audit event is processed, check on the spot whether the
# source site/OneDrive is allowed to create that link type; if not, file an
# immediate single-site remediation instead of waiting for the next sweep:
#   - AnonymousLinkCreated -> disable_sharing (needs SITE_POLICY_ENABLED=true;
#     covers SharePoint AND OneDrive). Allow list: site_allowlist.
#   - CompanyLinkCreated   -> cws_disallow_site (needs the CWS loops enabled).
#     Allow list: site_company_wide_sharing_allowlist + exception group.
# Default off because it writes production tenant settings.
EVENT_REMEDIATION_ENABLED=false

# --- Folder Rescan (weekly re-check of shared folders for new/modified files) ---
# Enable the weekly folder rescan loop in lifecycle-cron
FOLDER_RESCAN_ENABLED=true
# Hours between rescan cycles (default 168 = 7 days)
FOLDER_RESCAN_INTERVAL_HOURS=168
# Max folders to rescan per cycle
FOLDER_RESCAN_BATCH_SIZE=50

# --- Company-Wide Sharing Links Enforcement (PowerShell-based) ---
# Disables the "Anyone in your organization" sharing option on all SharePoint
# sites and OneDrive personal sites, except:
#  * Sites on the dashboard's "Company-Wide Sharing" allow list, and
#  * OneDrive users whose UPN is in the Entra ID group identified below.
#
# The pipeline runs entirely from PowerShell scripts (Invoke-Cws*.ps1) — the
# Python+CSOM remediation path doesn't work reliably at large tenant scale.
# pwsh + PnP.PowerShell 3.0.0 are baked into the lifecycle-cron image; main.py
# schedules the scripts via subprocess.
#
# Entra ID group object ID whose members are exempt from CWS remediation on
# their OneDrive (e.g., OrgWideSharingLinkException). Required by every CWS
# PowerShell script — fail-closed if empty.
COMPANY_WIDE_SHARING_EXCEPTION_GROUP_ID=

# --- CWS Verification Sweep (PowerShell, detect-only daily) ---
# Enumerates every site via Get-PnPTenantSite -Detailed -IncludePersonalSite
# (the SharePoint admin API view — more complete than Graph /sites/delta for
# newly provisioned sites). Records drift rows to cws_verification_events;
# never remediates.
CWS_VERIFICATION_ENABLED=false
# Full-tenant enumeration is slow, so the sweep runs weekly (168h). Drift
# recorded between sweeps is still applied daily by drift remediation below,
# and share-link events trigger immediate remediation (EVENT_REMEDIATION_ENABLED).
CWS_VERIFICATION_INTERVAL_HOURS=168

# --- CWS Drift Remediation (PowerShell, daily) ---
# Drains unresolved drift rows from cws_verification_events and calls
# Set-PnPTenantSite -DisableCompanyWideSharingLinks Disabled on each. Records
# outcomes to company_wide_sharing_events under trigger_type='drift_remediation'.
# Ship with DRY_RUN=true and inspect events before flipping to false.
CWS_DRIFT_REMEDIATION_ENABLED=false
CWS_DRIFT_REMEDIATION_INTERVAL_HOURS=24
CWS_DRIFT_REMEDIATION_DRY_RUN=true

# --- CWS Bulk Remediation (PowerShell, monthly safety net) ---
# Re-runs Invoke-CwsBulkRemediation.ps1 against the full tenant on a monthly
# cadence (idempotent — Disabled sites are recorded as already_compliant).
# Catches anything the verification sweep + drift remediation missed.
# NOTE: with DRY_RUN=true this loop is AUDIT-ONLY — it records
# dry_run_would_disable rows but never remediates. The daily drift-remediation
# drain is then the only remediating CWS path. Set DRY_RUN=false to make the
# monthly pass a real safety net.
CWS_BULK_REMEDIATION_ENABLED=false
CWS_BULK_REMEDIATION_INTERVAL_HOURS=720
CWS_BULK_REMEDIATION_DRY_RUN=true
CWS_BULK_REMEDIATION_THROTTLE=5

# --- CWS Allowlist Action (drains dashboard add/remove triggers) ---
# Consumer for the `sharesentinel:company_wide_sharing_action` Redis list.
# Each message is one site URL + cws_allow_site / cws_disallow_site. Action
# is explicit operator intent from the dashboard, so no dry-run gate — mirrors
# the site_policy_loop pattern. Disable if you need to silence the dashboard
# trigger temporarily.
CWS_ALLOWLIST_ACTION_ENABLED=true

# --- CWS Exception-Group Sync (10-min poll, diff-only remediation) ---
# Polls COMPANY_WIDE_SHARING_EXCEPTION_GROUP_ID at a short interval and diffs
# membership against the cws_exception_group_snapshot table. Most polls are a
# no-op. On membership change, runs Invoke-CwsExceptionMembershipDelta.ps1:
#   * Adds    → Set-PnPTenantSite -DisableCompanyWideSharingLinks NotDisabled
#               on the new member's OneDrive (re-enables CWS).
#   * Removes → Set-PnPTenantSite -DisableCompanyWideSharingLinks Disabled
#               on the former member's OneDrive.
# First run after an empty snapshot bootstraps without remediation — the
# verification sweep + drift remediation already handle the steady state.
CWS_EXCEPTION_GROUP_SYNC_ENABLED=false
CWS_EXCEPTION_GROUP_SYNC_INTERVAL_MINUTES=10
CWS_EXCEPTION_GROUP_SYNC_DRY_RUN=true

# CWS failure diagnostic loop
# Picks up sites/OneDrives whose latest event in company_wide_sharing_events is
# `failed` and runs the SharePoint-Oversharing-Toolkit's Diagnose-OneDriveSite.ps1
# to explain why (locked, quota exceeded, A1 license cap, deleted user, etc.).
# Result is upserted into cws_failure_diagnostics and surfaced on the dashboard.
# The diagnostic is read-only and can run alongside remediation.
CWS_FAILURE_DIAGNOSTIC_ENABLED=true
CWS_FAILURE_DIAGNOSTIC_INTERVAL_MINUTES=30
CWS_FAILURE_DIAGNOSTIC_MAX_PER_SWEEP=20
# Re-diagnose existing rows after this many hours so categories don't go stale.
CWS_FAILURE_DIAGNOSTIC_REFRESH_AFTER_HOURS=72
# Absolute host path to the SharePoint-Oversharing-Toolkit checkout. Mounted
# read-only at /opt/toolkit/ in the lifecycle-cron container. Leave unset to
# disable the diagnostic (failures will still be visible in the dashboard but
# without a parsed failure_category).
# TOOLKIT_HOST_PATH=/home/barclajo/SharePoint-Oversharing-Toolkit

# Certificate path for Graph API auth (dashboard + worker + lifecycle-cron)
AZURE_CERTIFICATE=./graph-api-cert.pfx
AZURE_CERTIFICATE_PASS=your-certificate-password

# --- Nginx / TLS ---
# Place certificate files in nginx/certs/:
#   sharesentinel.crt  (PEM certificate + chain)
#   sharesentinel.key  (PEM private key)

# --- Authentication ---
# AUTH_DISABLED=true is only honored together with DASHBOARD_ENV=development;
# the dashboard refuses to start with auth disabled in any other environment.
# AUTH_DISABLED=true
# DASHBOARD_ENV=development

# --- Entra ID SSO (OpenID Connect) ---
OIDC_TENANT_ID=your-entra-tenant-id
OIDC_CLIENT_ID=your-app-registration-client-id
OIDC_CLIENT_SECRET=your-app-registration-client-secret
OIDC_REDIRECT_URI=https://sharesentinel.yourorg.com/api/auth/callback
# Comma-separated Entra ID group IDs allowed to access the dashboard
# Include both ShareSentinel-Dashboard and ShareSentinel-Dashboard-Admin groups
OIDC_ALLOWED_GROUP_IDS=68c2a2bc-1618-4aec-bf26-e4fa68309796,6b4e03b9-7ffc-40d0-a720-0b008f290e2d
# Role-based access control — FAIL CLOSED: roles are granted ONLY through
# these groups. If OIDC_ADMIN_GROUP_IDS is empty, nobody gets the admin role
# (allow-list writes trigger immediate tenant-wide enforcement, so admin must
# be an explicit grant). Authenticated users without a role group are viewers.
# ShareSentinel-Dashboard-Admin group — members get admin role
OIDC_ADMIN_GROUP_IDS=6b4e03b9-7ffc-40d0-a720-0b008f290e2d
# ShareSentinel-Dashboard group — members get analyst role
OIDC_ANALYST_GROUP_IDS=68c2a2bc-1618-4aec-bf26-e4fa68309796
SESSION_SECRET_KEY=generate-a-random-64-char-secret

# --- Dashboard ---
DASHBOARD_URL=https://sharesentinel.yourorg.com
ALLOWED_ORIGINS=https://sharesentinel.yourorg.com
SHAREPOINT_ROOT_URL=https://yourtenant.sharepoint.com

# --- Watchdog (lifecycle-cron health monitoring + auto-restart) ---
# Power Automate workflow trigger URL (posts plain text to Teams)
TEAMS_WEBHOOK_URL=
# How often the watchdog checks loop heartbeats (seconds)
WATCHDOG_CHECK_INTERVAL_SECONDS=120
# How long before a heartbeat is considered stale (seconds)
WATCHDOG_HEARTBEAT_STALE_SECONDS=300
# How long before audit_poll_state.updated_at is considered stale (seconds)
WATCHDOG_POLL_STALE_SECONDS=3600
# Enable/disable automatic container restart on failure
WATCHDOG_AUTO_RESTART=true
# System-level alert thresholds (alert-only, no restart): worker heartbeat,
# jobs queue depth, dead-letter queues, failed scans/events, inspection age
WATCHDOG_QUEUE_DEPTH_ALERT=200
WATCHDOG_FAILED_EVENTS_ALERT_24H=20
WATCHDOG_INSPECTION_AGE_ALERT_DAYS=30

# --- Logging ---
LOG_LEVEL=INFO
